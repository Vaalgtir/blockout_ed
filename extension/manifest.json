{
  "manifest_version": 3,
  "name": "Bloqueur Instagram",
  "version": "0.1.0",
  "description": "Bloque une liste de comptes Instagram, à un rythme prudent pour éviter les restrictions.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["affichage.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Bloqueur Instagram" }
}
